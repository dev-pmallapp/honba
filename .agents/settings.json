{
  "securityPreset": "Turbo",
  "permissions": {
    "allow": [
      "command(regex:^git.*)",
      "command(regex:^gh.*)",
      "command(regex:^cargo.*)",
      "command(regex:^python3.*)",
      "command(regex:^python.*)",
      "command(regex:^pytest.*)",
      "command(regex:^maturin.*)",
      "command(regex:^ruff.*)",
      "command(regex:^pip.*)",
      "command(regex:^npm.*)",
      "command(regex:^npx.*)",
      "command(regex:^pnpm.*)",
      "command(regex:^node.*)",
      "command(regex:^ls.*)",
      "command(regex:^cat.*)",
      "command(regex:^mkdir.*)",
      "command(regex:^cp.*)",
      "command(regex:^mv.*)",
      "command(regex:^rm.*)",
      "command(regex:^find.*)",
      "command(regex:^grep.*)",
      "command(regex:^echo.*)",
      "command(regex:^touch.*)",
      "command(regex:^which.*)",
      "command(regex:^pwd.*)",
      "command(regex:^sync.*)",
      "command(regex:^sed.*)",
      "command(regex:^awk.*)"
    ]
  }
}