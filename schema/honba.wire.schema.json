{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dev-pmallapp/honba/schema/honba.wire.schema.json",
  "title": "honba wire schema",
  "description": "Single source of truth for data shared across Rust (serde), Python (pydantic) and TypeScript. Generated by tools/wiregen.py. Conventions: JSON field names are snake_case; times are epoch milliseconds UTC (`*_ms`, safe as a JS number); market-data prices/quantities are JSON numbers (f64); ledger money (costs, fills, positions, account) is `decimal` (a JSON string, exact); absent optional field means unknown / not applicable; enums are lowercase snake_case strings (except Product, which keeps Indian broker codes). `x-wt` / `x-qd` annotations record the WonderTrader / QuantDinger counterpart.",
  "x-version": "1.0.0",
  "$defs": {
    "AssetClass": {
      "description": "What an instrument is. Superset of WonderTrader ContractCategory, QuantDinger market_category and honba MarketSegment.",
      "type": "string",
      "enum": ["equity", "index", "etf", "mutual_fund", "bond", "future", "option", "commodity", "currency", "crypto_spot", "crypto_swap", "crypto_future", "crypto_option"],
      "x-wt": "ContractCategory: CC_Stock=equity, CC_Future=future, CC_FutOption/CC_SpotOption/CC_ETFOption=option, CC_Spot=commodity, CC_DC_*=crypto_*, CC_UserIndex=index"
    },
    "OptionKind": {
      "type": "string",
      "enum": ["call", "put"],
      "x-wt": "OptionType: OT_Call='1', OT_Put='2'"
    },
    "Side": {
      "description": "Order / fill direction.",
      "type": "string",
      "enum": ["buy", "sell"],
      "x-wt": "WTSBSDirectType: 'B', 'S'"
    },
    "PositionSide": {
      "description": "Holding direction.",
      "type": "string",
      "enum": ["long", "short"],
      "x-wt": "WTSDirectionType: WDT_LONG, WDT_SHORT",
      "x-qd": "qd_strategy_positions.side"
    },
    "Offset": {
      "description": "Open/close intent for venues that distinguish it (not used on NSE/BSE cash).",
      "type": "string",
      "enum": ["open", "close", "close_today", "close_yesterday"],
      "x-wt": "WTSOffsetType: WOT_OPEN, WOT_CLOSE, WOT_CLOSETODAY, WOT_CLOSEYESTERDAY"
    },
    "OrderType": {
      "type": "string",
      "enum": ["market", "limit", "stop", "stop_limit"],
      "x-wt": "WTSPriceType: WPT_ANYPRICE=market, WPT_LIMITPRICE=limit"
    },
    "TimeInForce": {
      "type": "string",
      "enum": ["day", "ioc", "fok", "gtc"],
      "x-wt": "WTSTimeCondition: WTC_IOC, WTC_GFD=day, WTC_GFS/GTC"
    },
    "Product": {
      "description": "Indian broker product type.",
      "type": "string",
      "enum": ["CNC", "MIS", "NRML", "MTF"]
    },
    "OrderStatus": {
      "type": "string",
      "enum": ["submitting", "open", "pending", "partially_filled", "filled", "cancelled", "expired", "rejected"],
      "x-wt": "WTSOrderState: WOS_Submitting, WOS_NotTraded_Queuing=open, WOS_PartTraded_Queuing=partially_filled, WOS_AllTraded=filled, WOS_Canceled=cancelled, WOS_Nottouched"
    },
    "Timeframe": {
      "type": "string",
      "enum": ["tick", "1m", "3m", "5m", "15m", "30m", "1h", "1d", "1w", "1M"],
      "x-names": ["Tick", "M1", "M3", "M5", "M15", "M30", "H1", "D1", "W1", "Mo1"],
      "x-wt": "WTSKlinePeriod: KP_Tick, KP_Minute1, KP_Minute5, KP_DAY, KP_Week, KP_Month"
    },
    "SessionPhase": {
      "type": "string",
      "enum": ["before_trading", "not_trading", "continuous", "auction_order", "auction_balance", "auction_match", "closed"],
      "x-wt": "WTSTradeStatus: TS_BeforeTrading..TS_Closed"
    },
    "ExecutionMode": {
      "type": "string",
      "enum": ["backtest", "paper", "live", "signal"],
      "x-qd": "qd_strategies_trading.execution_mode (signal|live)"
    },
    "StrategyStatus": {
      "type": "string",
      "enum": ["stopped", "running", "paused", "error"],
      "x-qd": "qd_strategies_trading.status"
    },
    "FillReason": {
      "type": "string",
      "enum": ["signal", "limit", "stop", "stop_loss", "take_profit", "trailing_stop", "square_off", "liquidate_end"],
      "x-qd": "qd_strategy_trades.close_reason"
    },
    "FeeAlgo": {
      "type": "string",
      "enum": ["none", "per_qty", "per_value"],
      "x-wt": "m_nFeeAlg: -1=none, 0=per_qty, 1=per_value"
    },

    "FeeSpec": {
      "description": "Per-instrument fee schedule (exchange/broker level; statutory Indian taxes live in Costs).",
      "type": "object",
      "properties": {
        "algo": { "$ref": "#/$defs/FeeAlgo" },
        "open": { "type": "number" },
        "close": { "type": "number" },
        "close_today": { "type": "number" }
      },
      "required": ["algo"],
      "x-wt": "WTSCommodityInfo m_dOpenFee/m_dCloseFee/m_dCloseTFee/m_nFeeAlg"
    },
    "Instrument": {
      "description": "Tradable instrument reference data (WTSContractInfo + WTSCommodityInfo + honba Instrument enum).",
      "type": "object",
      "properties": {
        "symbol": { "type": "string", "description": "Canonical id `{CODE}.{VENUE}`, e.g. RELIANCE.NSE, NIFTY24DECFUT.NSE." },
        "code": { "type": "string" },
        "exchange": { "type": "string", "description": "NSE, BSE, MCX, ..." },
        "asset_class": { "$ref": "#/$defs/AssetClass" },
        "name": { "type": "string" },
        "isin": { "type": "string" },
        "underlying": { "type": "string" },
        "product_id": { "type": "string", "description": "Product family id, e.g. NIFTY." },
        "currency": { "type": "string" },
        "lot_size": { "type": "number", "description": "Minimum order lot (NSE F&O lot)." },
        "multiplier": { "type": "number", "description": "Contract value multiplier (WT m_uVolScale)." },
        "tick_size": { "type": "number" },
        "qty_step": { "type": "number" },
        "min_qty": { "type": "number" },
        "max_market_qty": { "type": "number" },
        "max_limit_qty": { "type": "number" },
        "freeze_qty": { "type": "number" },
        "price_band_pct": { "type": "number" },
        "settlement_days": { "type": "integer", "format": "uint32" },
        "listed_ms": { "type": "integer", "format": "int64" },
        "expiry_ms": { "type": "integer", "format": "int64" },
        "strike": { "type": "number" },
        "option_kind": { "$ref": "#/$defs/OptionKind" },
        "long_margin_rate": { "type": "number" },
        "short_margin_rate": { "type": "number" },
        "fees": { "$ref": "#/$defs/FeeSpec" },
        "session": { "type": "string", "description": "Trading-session template id." }
      },
      "required": ["symbol", "code", "exchange", "asset_class", "lot_size", "tick_size"]
    },

    "Bar": {
      "description": "One OHLCV candle. `time_ms` is the bar's open time.",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "timeframe": { "$ref": "#/$defs/Timeframe" },
        "time_ms": { "type": "integer", "format": "int64" },
        "open": { "type": "number" },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "close": { "type": "number" },
        "volume": { "type": "number" },
        "turnover": { "type": "number" },
        "open_interest": { "type": "number" },
        "settle": { "type": "number" }
      },
      "required": ["symbol", "timeframe", "time_ms", "open", "high", "low", "close", "volume"],
      "x-wt": "WTSBarStruct (date/time/open/high/low/close/settle/money=turnover/vol/hold=open_interest)"
    },
    "DepthLevel": {
      "type": "object",
      "properties": {
        "price": { "type": "number" },
        "qty": { "type": "number" }
      },
      "required": ["price", "qty"]
    },
    "Tick": {
      "description": "Level-1/N snapshot. `volume`/`turnover` are since the previous tick; `total_*` are session cumulative.",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "time_ms": { "type": "integer", "format": "int64" },
        "trading_date": { "type": "integer", "format": "uint32", "description": "YYYYMMDD" },
        "price": { "type": "number" },
        "open": { "type": "number" },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "pre_close": { "type": "number" },
        "pre_settle": { "type": "number" },
        "settle": { "type": "number" },
        "upper_limit": { "type": "number" },
        "lower_limit": { "type": "number" },
        "volume": { "type": "number" },
        "total_volume": { "type": "number" },
        "turnover": { "type": "number" },
        "total_turnover": { "type": "number" },
        "open_interest": { "type": "number" },
        "pre_open_interest": { "type": "number" },
        "bids": { "type": "array", "items": { "$ref": "#/$defs/DepthLevel" } },
        "asks": { "type": "array", "items": { "$ref": "#/$defs/DepthLevel" } }
      },
      "required": ["symbol", "time_ms", "price"],
      "x-wt": "WTSTickStruct (bid_prices[10]/bid_qty[10] folded into DepthLevel lists)"
    },
    "TickEvent": {
      "type": "object",
      "properties": {
        "kind": { "const": "tick" },
        "tick": { "$ref": "#/$defs/Tick" }
      },
      "required": ["kind", "tick"]
    },
    "BarEvent": {
      "type": "object",
      "properties": {
        "kind": { "const": "bar" },
        "bar": { "$ref": "#/$defs/Bar" }
      },
      "required": ["kind", "bar"]
    },
    "MarketEvent": {
      "description": "Streamed market data (tagged by `kind`).",
      "oneOf": [
        { "$ref": "#/$defs/TickEvent" },
        { "$ref": "#/$defs/BarEvent" }
      ],
      "discriminator": { "propertyName": "kind" }
    },

    "Trail": {
      "type": "object",
      "properties": {
        "offset": { "type": "number" },
        "is_pct": { "type": "boolean" }
      },
      "required": ["offset", "is_pct"]
    },
    "OrderRequest": {
      "description": "Intent to trade, as submitted by a strategy or a UI.",
      "type": "object",
      "properties": {
        "client_order_id": { "type": "string" },
        "symbol": { "type": "string" },
        "side": { "$ref": "#/$defs/Side" },
        "order_type": { "$ref": "#/$defs/OrderType" },
        "product": { "$ref": "#/$defs/Product" },
        "tif": { "$ref": "#/$defs/TimeInForce" },
        "qty": { "type": "number" },
        "price": { "type": "number" },
        "trigger_price": { "type": "number" },
        "offset": { "$ref": "#/$defs/Offset" },
        "stop_loss": { "type": "number" },
        "take_profit": { "type": "number" },
        "trail": { "$ref": "#/$defs/Trail" },
        "strategy_id": { "type": "string" },
        "tag": { "type": "string" },
        "time_ms": { "type": "integer", "format": "int64" }
      },
      "required": ["client_order_id", "symbol", "side", "order_type", "qty", "time_ms"],
      "x-wt": "WTSEntrust",
      "x-qd": "pending_orders"
    },
    "Order": {
      "description": "An order and its lifecycle state (request + engine/broker state).",
      "type": "object",
      "properties": {
        "order_id": { "type": "string" },
        "request": { "$ref": "#/$defs/OrderRequest" },
        "status": { "$ref": "#/$defs/OrderStatus" },
        "filled_qty": { "type": "number" },
        "avg_fill_price": { "type": "number" },
        "reason": { "type": "string", "description": "Reject / cancel reason code or message." },
        "created_ms": { "type": "integer", "format": "int64" },
        "updated_ms": { "type": "integer", "format": "int64" }
      },
      "required": ["order_id", "request", "status", "filled_qty", "created_ms", "updated_ms"],
      "x-wt": "WTSOrderInfo"
    },
    "Costs": {
      "description": "Transaction costs of a fill, per component (quote currency). Mirrors honba TradeCosts.",
      "type": "object",
      "properties": {
        "brokerage": { "type": "string", "format": "decimal" },
        "stt": { "type": "string", "format": "decimal" },
        "exchange_fee": { "type": "string", "format": "decimal" },
        "sebi_fee": { "type": "string", "format": "decimal" },
        "stamp_duty": { "type": "string", "format": "decimal" },
        "gst": { "type": "string", "format": "decimal" },
        "dp": { "type": "string", "format": "decimal" },
        "total": { "type": "string", "format": "decimal" }
      },
      "required": ["total"]
    },
    "Fill": {
      "type": "object",
      "properties": {
        "fill_id": { "type": "string" },
        "order_id": { "type": "string" },
        "symbol": { "type": "string" },
        "side": { "$ref": "#/$defs/Side" },
        "qty": { "type": "string", "format": "decimal" },
        "price": { "type": "string", "format": "decimal" },
        "reason": { "$ref": "#/$defs/FillReason" },
        "costs": { "$ref": "#/$defs/Costs" },
        "time_ms": { "type": "integer", "format": "int64" }
      },
      "required": ["fill_id", "order_id", "symbol", "side", "qty", "price", "time_ms"],
      "x-wt": "WTSTradeInfo",
      "x-qd": "qd_strategy_trades"
    },
    "Position": {
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "product": { "$ref": "#/$defs/Product" },
        "side": { "$ref": "#/$defs/PositionSide" },
        "qty": { "type": "string", "format": "decimal", "description": "Absolute quantity held." },
        "avg_price": { "type": "string", "format": "decimal" },
        "mark_price": { "type": "string", "format": "decimal" },
        "realized_pnl": { "type": "string", "format": "decimal" },
        "unrealized_pnl": { "type": "string", "format": "decimal" },
        "margin": { "type": "string", "format": "decimal" },
        "prev_qty": { "type": "string", "format": "decimal", "description": "Carried from earlier sessions (WT m_dPrePosition)." },
        "available_qty": { "type": "string", "format": "decimal", "description": "Closable now (T+1 / unsettled excluded)." },
        "updated_ms": { "type": "integer", "format": "int64" }
      },
      "required": ["symbol", "side", "qty", "avg_price", "realized_pnl", "unrealized_pnl", "updated_ms"],
      "x-wt": "WTSPositionItem",
      "x-qd": "qd_strategy_positions"
    },
    "Account": {
      "type": "object",
      "properties": {
        "account_id": { "type": "string" },
        "currency": { "type": "string" },
        "cash": { "type": "string", "format": "decimal" },
        "available": { "type": "string", "format": "decimal" },
        "unsettled": { "type": "string", "format": "decimal" },
        "margin_used": { "type": "string", "format": "decimal" },
        "equity": { "type": "string", "format": "decimal" },
        "realized_pnl": { "type": "string", "format": "decimal" },
        "unrealized_pnl": { "type": "string", "format": "decimal" },
        "fees_paid": { "type": "string", "format": "decimal" },
        "time_ms": { "type": "integer", "format": "int64" }
      },
      "required": ["account_id", "currency", "cash", "equity", "time_ms"],
      "x-wt": "WTSAccountInfo / WTSFundStruct",
      "x-qd": "qd_strategy_virtual_accounts"
    },

    "Signal": {
      "type": "object",
      "properties": {
        "strategy_id": { "type": "string" },
        "symbol": { "type": "string" },
        "side": { "$ref": "#/$defs/Side" },
        "strength": { "type": "number", "description": "0..1 conviction." },
        "target_qty": { "type": "number" },
        "reason": { "type": "string" },
        "time_ms": { "type": "integer", "format": "int64" }
      },
      "required": ["strategy_id", "symbol", "side", "time_ms"],
      "x-qd": "qd_indicator_signal_alerts"
    },
    "StrategyConfig": {
      "type": "object",
      "properties": {
        "strategy_id": { "type": "string" },
        "name": { "type": "string" },
        "execution_mode": { "$ref": "#/$defs/ExecutionMode" },
        "status": { "$ref": "#/$defs/StrategyStatus" },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "timeframe": { "$ref": "#/$defs/Timeframe" },
        "initial_capital": { "type": "string", "format": "decimal" },
        "leverage": { "type": "number" },
        "params": { "type": "object", "additionalProperties": true, "description": "Free-form strategy parameters." },
        "created_ms": { "type": "integer", "format": "int64" },
        "updated_ms": { "type": "integer", "format": "int64" }
      },
      "required": ["strategy_id", "name", "execution_mode", "symbols", "timeframe", "initial_capital"],
      "x-qd": "qd_strategies_trading"
    },

    "EquityPoint": {
      "type": "object",
      "properties": {
        "time_ms": { "type": "integer", "format": "int64" },
        "equity": { "type": "number" }
      },
      "required": ["time_ms", "equity"],
      "x-qd": "qd_backtest_equity_points"
    },
    "RoundTrip": {
      "description": "One completed entry-to-exit trade in a backtest.",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "side": { "$ref": "#/$defs/PositionSide" },
        "qty": { "type": "number" },
        "entry_ms": { "type": "integer", "format": "int64" },
        "exit_ms": { "type": "integer", "format": "int64" },
        "entry_price": { "type": "number" },
        "exit_price": { "type": "number" },
        "pnl": { "type": "number" },
        "costs": { "type": "number" },
        "exit_reason": { "$ref": "#/$defs/FillReason" }
      },
      "required": ["symbol", "side", "qty", "entry_ms", "exit_ms", "entry_price", "exit_price", "pnl"],
      "x-qd": "qd_backtest_trades"
    },
    "Metrics": {
      "type": "object",
      "properties": {
        "total_return": { "type": "number" },
        "cagr": { "type": "number" },
        "sharpe": { "type": "number" },
        "sortino": { "type": "number" },
        "max_drawdown": { "type": "number" },
        "win_rate": { "type": "number" },
        "profit_factor": { "type": "number" },
        "n_trades": { "type": "integer", "format": "uint32" }
      },
      "required": ["total_return", "max_drawdown", "n_trades"]
    },
    "BacktestRun": {
      "type": "object",
      "properties": {
        "run_id": { "type": "string" },
        "strategy_id": { "type": "string" },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "timeframe": { "$ref": "#/$defs/Timeframe" },
        "start_ms": { "type": "integer", "format": "int64" },
        "end_ms": { "type": "integer", "format": "int64" },
        "initial_capital": { "type": "string", "format": "decimal" },
        "params": { "type": "object", "additionalProperties": true },
        "metrics": { "$ref": "#/$defs/Metrics" },
        "trades": { "type": "array", "items": { "$ref": "#/$defs/RoundTrip" } },
        "equity": { "type": "array", "items": { "$ref": "#/$defs/EquityPoint" } },
        "created_ms": { "type": "integer", "format": "int64" }
      },
      "required": ["run_id", "strategy_id", "symbols", "timeframe", "start_ms", "end_ms", "initial_capital", "metrics"],
      "x-qd": "qd_backtest_runs"
    }
  }
}
